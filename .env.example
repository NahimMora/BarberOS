# ──────────────────────────────────────────────
# Supabase → Project Settings → API
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Solo server-side. NUNCA exponer al cliente.
# Usar exclusivamente en scripts/seed.ts y admin tasks puntuales.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
#
# Railway y Render corren un proceso Node persistente (no serverless), así
# que la razón para usar el pooler no es "conexiones efímeras" como en
# Vercel — es que la conexión directa de Supabase (puerto 5432) es IPv6 por
# defecto, y muchas plataformas no garantizan salida IPv6. Ver:
# https://supabase.com/docs/guides/troubleshooting/supabase--your-network-ipv4-and-ipv6-compatibility-cHe3BP
#
# Salvo que hayas confirmado egress IPv6 en tu plataforma (o pagues el
# IPv4 add-on de Supabase), usá el Session Pooler para AMBAS variables
# (Supabase → Project Settings → Database → Connection Pooling → Session
# mode). Es compatible con IPv4, soporta prepared statements igual que una
# conexión directa, y no recicla conexiones a los 5 minutos como el
# Transaction pooler.

# Runtime (App Router, Server Actions, Route Handlers)
# Session Pooler, puerto 5432 (o Transaction Pooler puerto 6543 si preferís
# pool de conexiones a nivel de Supabase en vez de en la app).
DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# Migraciones (drizzle-kit migrate) — necesita DDL, no puede ir por
# Transaction pooler. Session Pooler o Direct Connection (si tenés IPv6).
DIRECT_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
